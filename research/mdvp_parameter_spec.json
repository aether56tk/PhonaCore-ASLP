{
  "referenceSystem": "KayPENTAX Multi-Dimensional Voice Program (MDVP) Model 5105",
  "sourceBasis": "MDVP Model 5105 specification supplied for the PhonaCore validation workflow; implementation targets below must be confirmed by paired empirical validation.",
  "parameterMapping": [
    {
      "mdvp": "F0",
      "phonacore": "f0Mean",
      "unit": "Hz",
      "formula": "mean(valid F0 periods)",
      "window": null
    },
    {
      "mdvp": "Fhi",
      "phonacore": "f0Max",
      "unit": "Hz",
      "formula": "maximum(valid F0)",
      "window": null
    },
    {
      "mdvp": "Flo",
      "phonacore": "f0Min",
      "unit": "Hz",
      "formula": "minimum(valid F0)",
      "window": null
    },
    {
      "mdvp": "STD",
      "phonacore": "f0Sd",
      "unit": "Hz",
      "formula": "sample SD of valid F0",
      "window": "full sample"
    },
    {
      "mdvp": "T0",
      "phonacore": "t0Ms",
      "unit": "ms",
      "formula": "1000 × mean(period)",
      "window": "full sample"
    },
    {
      "mdvp": "Jita",
      "phonacore": "jitaUs",
      "unit": "us",
      "formula": "mean(abs(P[i]-P[i-1])) × 1e6",
      "window": "adjacent periods"
    },
    {
      "mdvp": "Jitt",
      "phonacore": "jittPct",
      "unit": "%",
      "formula": "100 × Jita / mean(period)",
      "window": "full sample"
    },
    {
      "mdvp": "RAP",
      "phonacore": "rapPct",
      "unit": "%",
      "formula": "100 × mean(abs(center - movingMean(center, 3))/abs(movingMean))",
      "window": 3
    },
    {
      "mdvp": "PPQ",
      "phonacore": "ppqPct",
      "unit": "%",
      "formula": "100 × mean(abs(center - movingMean(center, 5))/abs(movingMean))",
      "window": 5
    },
    {
      "mdvp": "sPPQ",
      "phonacore": "sppqPct",
      "unit": "%",
      "formula": "100 × mean(abs(center - movingMean(center, 55))/abs(movingMean))",
      "window": 55
    },
    {
      "mdvp": "vF0",
      "phonacore": "vf0Pct",
      "unit": "%",
      "formula": "100 × SD(F0) / mean(F0)",
      "window": "full sample"
    },
    {
      "mdvp": "ShdB",
      "phonacore": "shdB",
      "unit": "dB",
      "formula": "mean(abs(20 × log10(A[i]/A[i-1])))",
      "window": "adjacent amplitudes"
    },
    {
      "mdvp": "Shim",
      "phonacore": "shimPct",
      "unit": "%",
      "formula": "100 × mean(abs(A[i]-A[i-1])/((A[i]+A[i-1])/2))",
      "window": "adjacent amplitudes"
    },
    {
      "mdvp": "APQ",
      "phonacore": "apqPct",
      "unit": "%",
      "formula": "100 × mean(abs(center - movingMean(center, 11))/abs(movingMean))",
      "window": 11
    },
    {
      "mdvp": "sAPQ",
      "phonacore": "sapqPct",
      "unit": "%",
      "formula": "100 × mean(abs(center - movingMean(center, 55))/abs(movingMean))",
      "window": 55
    },
    {
      "mdvp": "vAm",
      "phonacore": "vamPct",
      "unit": "%",
      "formula": "100 × SD(peak-to-peak amplitude) / mean(peak-to-peak amplitude)",
      "window": "full sample"
    },
    {
      "mdvp": "NHR",
      "phonacore": "nhr",
      "unit": "ratio",
      "formula": "spectral noise/harmonic ratio; frequency bands require reference-setting verification",
      "window": "spectral"
    }
  ],
  "nonDirect": [
    {
      "mdvp": "VTI",
      "phonacore": "vti",
      "status": "prototype; spectral band definition implemented only partially"
    },
    {
      "mdvp": "SPI",
      "phonacore": "spi",
      "status": "prototype; spectral band definition implemented only partially"
    },
    {
      "mdvp": "CPP",
      "phonacore": "cppPrototypeDb",
      "status": "additional measure, not an MDVP equivalence endpoint"
    }
  ],
  "validation": {
    "pairing": "Analyze the identical WAV in both systems.",
    "metrics": [
      "bias",
      "MAE",
      "RMSE",
      "Bland-Altman limits of agreement",
      "CCC",
      "ICC"
    ],
    "note": "Correlation alone is not agreement."
  }
}
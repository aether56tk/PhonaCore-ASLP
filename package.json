{
  "name": "phonacore-aslp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run build",
    "build": "node -e \"const fs=require('fs'); for (const f of ['public/index.html','public/app.css','public/app.js','public/dsp.js']) if(!fs.existsSync(f)) process.exit(1); console.log('Static build check passed')\"",
    "synthetic": "node -e \"import('./src/research/syntheticVoice.js').then(m=>console.log(JSON.stringify(m.runSyntheticBench(),null,2)))\"",
    "synthetic:benchmark": "node -e \"import('./src/research/syntheticVoice.js').then(m=>console.log(JSON.stringify(m.runSyntheticBenchmark(),null,2)))\""
  },
  "engines": {
    "node": ">=20"
  }
}
